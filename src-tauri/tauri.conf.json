{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MILKMAN",
  "version": "0.0.1",
  "identifier": "com.mivim.milkman",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MILKMAN",
        "width": 1040,
        "height": 660,
        "minWidth": 760,
        "minHeight": 480,
        "dragDropEnabled": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
